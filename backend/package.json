{
    "name": "hackutd-disaster-backend",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit -p spacetimedb && tsc --noEmit -p client",
        "lint": "prettier --check spacetimedb/src client/connect.ts client/login.ts tests scripts vitest.config.mts",
        "build": "spacetime build --module-path spacetimedb",
        "generate": "spacetime generate --lang typescript --out-dir client/module_bindings --module-path spacetimedb --yes",
        "test:local": "node scripts/local.mjs test",
        "dev": "node scripts/local.mjs dev",
        "test": "vitest run && node scripts/local.mjs test",
        "test:auth": "vitest run"
    },
    "dependencies": {
        "spacetimedb": "2.14.0"
    },
    "devDependencies": {
        "prettier": "^3.8.0",
        "typescript": "~5.6.2",
        "vitest": "^4.1.12"
    }
}
