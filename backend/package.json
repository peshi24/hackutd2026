{
    "name":  "hackutd-disaster-backend",
    "private":  true,
    "scripts":  {
                    "typecheck":  "tsc --noEmit -p spacetimedb \u0026\u0026 tsc --noEmit -p client",
                    "lint":  "prettier --check spacetimedb/src client/connect.ts tests/integration.mjs scripts",
                    "build":  "spacetime build --module-path spacetimedb",
                    "generate":  "spacetime generate --lang typescript --out-dir client/module_bindings --module-path spacetimedb --yes",
                    "test:local":  "tsc -p client/tsconfig.test.json \u0026\u0026 node tests/integration.mjs",
                    "dev":  "node scripts/local.mjs dev",
                    "test":  "node scripts/local.mjs test"
                },
    "dependencies":  {
                         "spacetimedb":  "2.14.0"
                     },
    "devDependencies":  {
                            "typescript":  "~5.6.2",
                            "prettier":  "^3.8.0"
                        }
}
